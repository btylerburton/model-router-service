# model-router-service configuration (12-factor).
# Copy to .env for local dev. NEVER commit a real .env (see .gitignore).
# Every value here is an ENVIRONMENT VARIABLE — no host/url/model is hardcoded
# in the code. The same build runs locally, in a sandbox, and on cloud.gov;
# only these values change.

# --- Upstream gateway (REQUIRED) ------------------------------------------
# The OpenAI-compatible endpoint every routed request is forwarded to.
ROUTER_UPSTREAM_BASE_URL=https://api.gsa.usai.gov/api/v1
ROUTER_UPSTREAM_API_KEY=replace-me-with-a-real-key

# --- Judge (the cheap model id used ONLY if the judge is enabled) ---------
# A small/fast model used to rank candidates. The judge is OPT-IN (off by
# default — see ROUTER_JUDGE_ENABLED below). Defaults to the upstream gateway +
# key above; override the two below to use a different judge endpoint.
ROUTER_JUDGE_MODEL=claude_4_5_haiku
# ROUTER_JUDGE_BASE_URL=
# ROUTER_JUDGE_API_KEY=

# --- Routing behavior (REQUIRED: default_model) ---------------------------
# Model forwarded to when routing/judging fails (fail-open landing model).
ROUTER_DEFAULT_MODEL=claude_4_5_sonnet

# Optional explicit candidate roster (JSON). When unset, candidates are
# discovered from the upstream /models list + a built-in family capability map.
# ROUTER_CATALOG_PATH=/etc/model-router/roster.json

# Judge invocation controls.
# OFF by default: the deterministic graded scorer routes offline in sub-ms with
# no network call, which is the fast path. Set true ONLY to add the per-prompt
# LLM judge (an extra upstream inference round-trip = real added latency), as an
# escalation for deployments that measured the scorer misrouting.
ROUTER_JUDGE_ENABLED=false
ROUTER_JUDGE_TIMEOUT_S=4
ROUTER_JUDGE_CACHE_SIZE=512

# Pin/bypass + audit headers.
ROUTER_BYPASS_HEADER=x-model-router-bypass
ROUTER_DECISION_HEADER=x-model-router-decision

# --- Harness utility-call pass-through ------------------------------------
# Agent harnesses (OpenCode/Paseo) make non-task utility calls through the same
# endpoint (thread-title generation, summarization, compaction). When true,
# calls whose SYSTEM prompt matches a known utility signature are forced to the
# cheapest model and skip scoring (logged via=utility).
ROUTER_PASSTHROUGH_UTILITY=true
# ROUTER_CHEAPEST_MODEL=     # unset = cheapest in the catalog by cost_rank

# --- Decision logging (developer observability; NOT user-facing) ----------
# By default the decision log records METADATA only (prompt_hash, chosen, band)
# — NOT raw prompt text, which carries repo contents / PR bodies / paths. Enable
# ROUTER_LOG_PROMPTS ONLY for local debugging.
ROUTER_LOG_PROMPTS=false
# The /feedback correction endpoint + in-memory recent-decision ring are OFF by
# default (the correction UX is not built; off = zero per-turn overhead). Enable
# only when a correction UX exists.
ROUTER_FEEDBACK_ENABLED=false

# Server bind (local dev). On cloud.gov, $PORT overrides and forces 0.0.0.0.
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8080
ROUTER_LOG_LEVEL=INFO
ROUTER_UPSTREAM_TIMEOUT_S=600

# --- TLS trust (hosts behind a TLS-inspecting proxy, e.g. Zscaler) --------
# httpx verifies TLS against certifi by default, which does NOT include a
# corporate proxy root. Behind Zscaler the handshake fails — and the gateway
# often returns a 401/block page rather than a clean TLS error. Point this at a
# CA bundle that INCLUDES the proxy root. On a managed host the system store
# usually already has it. This is the service-side equivalent of acq's
# persistent zscaler-ca-certificate kit. Leave UNSET on cloud.gov / normal egress.
# ROUTER_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# (macOS/Homebrew OpenSSL alt: /opt/homebrew/etc/openssl@3/cert.pem)
# (or just the proxy root:   /path/to/zscaler-root.pem)
